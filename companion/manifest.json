{
  "manifest_version": 3,
  "name": "Pathbuilder Dice Bridge for Owlbear Rodeo",
  "short_name": "PB Dice Bridge",
  "version": "1.0.0",
  "description": "Lets the Pathbuilder Dice Owlbear Rodeo extension show Pathbuilder 2e in its sheet panel and send its rolls to the 3D dice tray.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["declarativeNetRequestWithHostAccess"],
  "host_permissions": [
    "https://pathbuilder2e.com/*",
    "https://www.pathbuilder2e.com/*",
    "https://gmredvelvet-rgb.github.io/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "allow_pathbuilder_in_panel",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["https://pathbuilder2e.com/*", "https://www.pathbuilder2e.com/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
